          "type": "string",
          "required": true
        },
        "name": {
          "type": "string",
          "required": true
        },
        "contactEmail": {
          "type": "string",
          "required": false
        },
        "contactPhone": {
          "type": "string",
          "required": false
        },
        "whatsapp": {
          "type": "string",
          "required": false
        },
        "wechatId": {
          "type": "string",
          "required": false
        },
        "country": {
          "type": "string",
          "required": false
        },
        "type": {
          "type": "string",
          "required": true
        },
        "notes": {
          "type": "string",
          "required": false
        },
        "createdAt": {
          "type": "string",
          "required": true
        },
        "updatedAt": {
          "type": "string",
          "required": true
        }
      }
    }
  },
  "securityRules": {
    "description": "Enforce strict per-user ownership and isolation. Users can only read and write their own data.",
    "rules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /users/{userId} {\n      allow read, write: if request.auth != null && request.auth.uid == userId;\n      match /{subcollection=**} {\n        allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n    }\n  }\n}"
  }
}