          "type": "string",
          "required": true
        },
        "inquiryNumber": {
          "type": "string",
          "required": true
        },
        "date": {
          "type": "string",
          "required": true
        },
        "customerName": {
          "type": "string",
          "required": true
        },
        "customerContact": {
          "type": "string",
          "required": false
        },
        "wechatId": {
          "type": "string",
          "required": false
        },
        "country": {
          "type": "string",
          "required": true
        },
        "product": {
          "type": "string",
          "required": true
        },
        "imageUrl": {
          "type": "string",
          "required": false
        },
        "material": {
          "type": "string",
          "required": false
        },
        "colorVariant": {
          "type": "string",
          "required": false
        },
        "packagingType": {
          "type": "string",
          "required": false
        },
        "hsCode": {
          "type": "string",
          "required": false
        },
        "boxLengthCm": {
          "type": "number",
          "required": false
        },
        "boxWidthCm": {
          "type": "number",
          "required": false
        },
        "boxHeightCm": {
          "type": "number",
          "required": false
        },
        "pcsPerBox": {
          "type": "number",
          "required": false
        },
        "unitWeightG": {
          "type": "number",
          "required": false
        },
        "grossWeightKg": {
          "type": "number",
          "required": false
        },
        "netWeightKg": {
          "type": "number",
          "required": false
        },
        "productUrl1688": {
          "type": "string",
          "required": false
        },
        "supplierName": {
          "type": "string",
          "required": false
        },
        "quantity": {
          "type": "number",
          "required": true
        },
        "price1688Rmb": {
          "type": "number",
          "required": true
        },
        "domesticShippingRmb": {
          "type": "number",
