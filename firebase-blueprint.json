  "securityRules": {
    "description": "Enforce strict per-user ownership and isolation. Users can only read and write their own data.",
    "rules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /test/connection {\n      allow read: if true;\n    }\n    match /users/{userId} {\n      allow read, write: if request.auth != null && request.auth.uid == userId;\n      match /{subcollection=**} {\n        allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n    }\n  }\n}"
  }
