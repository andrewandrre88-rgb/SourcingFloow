        },
        "clientUnitPriceUsd": {
          "type": "number",
          "required": true
        },
        "totalQuotationUsd": {
          "type": "number",
          "required": true
        },
        "estimatedProfitUsd": {
          "type": "number",
          "required": true
        },
        "helperCommissions": {
          "type": "array",
          "required": false
        },
        "totalHelperCommissionUsd": {
          "type": "number",
          "required": false
        },
        "netAgentProfitUsd": {
          "type": "number",
          "required": false
        },
        "orderStatus": {
          "type": "string",
